# H2
DB_NAME=springai_db
DB_PASSWORD=
DB_USER=sa

# INGESTION PIPELINE
INGEST_FILES_FILTER=.*\.(md|pdf|txt)
# in ms (how fast to check MiniIO for new files)
INGEST_POLL_INTERVAL=20000

# MINIO
MINIO_DEFAULT_BUCKET=default
MINIO_ROOT_PASSWORD=password
MINIO_ROOT_USER=username

# OLLAMA
# https://ollama.com/library/nomic-embed-text-v2-moe
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# https://ollama.com/library/gemma4:e4b/
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_K=4
OLLAMA_TOP_P=0.8
