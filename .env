# H2
DB_NAME=test_db
DB_PASSWORD=
DB_USER=sa

# INGESTION PIPELINE
INGEST_DIR=./docs/
INGEST_FILES_FILTER=.*\.(md|pdf|txt)

# OLLAMA
# https://ollama.com/library/nomic-embed-text-v2-moe
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# https://ollama.com/library/gemma4:e4b/
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_K=4
OLLAMA_TOP_P=0.8
