{
  "scripts": {
    "build": "npm run typecheck && vite build",
    "build:dev": "npm run typecheck && vite build --mode development",
    "clean": "npm prune && npm cache verify",
    "clear": "npm run clean",
    "format": "npx prettier **/*.{cjs,css,html,js,json,md,mjs,scss,svg,tjs,ts,xml,yaml,yml} --write",
    "lint": "npx eslint",
    "mcp": "npx @modelcontextprotocol/inspector",
    "ncu": "npx ncu",
    "typecheck": "npx tsc --noEmit"
  },
  "type": "module",
  "devDependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "@modelcontextprotocol/inspector": "^0.22.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@rollup/plugin-strip": "^3.0.4",
    "@tailwindcss/vite": "^4.3.1",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.15.12",
    "daisyui": "^5.5.23",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "htmx.org": "^2.0.10",
    "npm-check-updates": "^22.2.3",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "prettier": {
    "attributeSort": "ASC",
    "bracketSameLine": true,
    "plugins": [
      "@prettier/plugin-xml",
      "prettier-plugin-organize-attributes",
      "prettier-plugin-tailwindcss"
    ],
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "singleAttributePerLine": true
  }
}
