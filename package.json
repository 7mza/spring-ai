{
  "scripts": {
    "build": "cross-env NODE_ENV=production npx webpack --mode=production",
    "build:dev": "cross-env NODE_ENV=development npx webpack --mode=development",
    "clean": "npm prune && npm cache verify",
    "clear": "npm run clean",
    "format": "npx prettier **/*.{cjs,css,html,js,json,md,mjs,scss,svg,tjs,ts,xml,yaml,yml} --write",
    "lint": "npx eslint",
    "mcp": "npx @modelcontextprotocol/inspector",
    "ncu": "npx ncu"
  },
  "type": "module",
  "devDependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.15.12",
    "babel-loader": "^10.1.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "daisyui": "^5.5.20",
    "eslint": "^10.4.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.6.0",
    "htmx.org": "^2.0.10",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-check-updates": "^22.2.1",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "webpack": "^5.107.2",
    "webpack-assets-manifest": "^6.5.2",
    "webpack-cli": "^7.0.3"
  },
  "prettier": {
    "attributeSort": "ASC",
    "bracketSameLine": true,
    "plugins": [
      "@prettier/plugin-xml",
      "prettier-plugin-organize-attributes",
      "prettier-plugin-tailwindcss"
    ],
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "singleAttributePerLine": true
  },
  "browserslist": [
    ">0.3%, defaults, fully supports es6-module"
  ]
}
